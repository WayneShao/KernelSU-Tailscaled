#!/system/bin/sh
# shellcheck disable=SC3043
SCRIPT_DIR=${0%/*}
. "$SCRIPT_DIR/common.sh"

runtime_stop() {
  local failed=0
  printf '0\n' > "$RUN_DIR/wanted"
  # The supervisor's TERM trap exits without acquiring this controller lock.
  stop_owned "$SUPERVISOR_PID" "$SUPERVISOR_SCRIPT" || failed=1
  "$KST_SHELL" "$TAILDROP_SCRIPT" stop 9>&9 || failed=1
  "$KST_SHELL" "$WEB_SCRIPT" stop 9>&9 || failed=1
  "$KST_SHELL" "$TUNNEL_SCRIPT" stop 9>&9 || failed=1
  "$KST_SHELL" "$DAEMON_SCRIPT" stop 9>&9 || failed=1
  if [ "$failed" = 1 ]; then
    set_lifecycle failed
    echo 'Tailscale runtime stop failed; retained owned process records' >&2
    return 1
  fi
  set_lifecycle stopped
  echo 'Tailscale runtime stopped'
}

migration_required() {
  [ -f "$TS_DIR/migration-required" ] || [ -e "$TS_DIR/migration.pending" ] || {
    [ ! -e "$STATE_FILE" ] && {
      [ -e "${KST_LEGACY_DIR:-/data/adb/tailscale}/tailscaled.state" ] || [ -e "${KST_LEGACY_DIR:-/data/adb/tailscale}/tmp/tailscaled.state" ]
    }
  }
}

runtime_start() {
  if module_disabled; then echo 'Tailscale module is disabled' >&2; return 1; fi
  if migration_required; then set_lifecycle migration-required; echo 'Legacy identity requires explicit migration' >&2; return 1; fi
  printf '1\n' > "$RUN_DIR/wanted"
  if ! load_config; then
    set_lifecycle failed
    log ERROR "$CONFIG_ERROR"
    echo "$CONFIG_ERROR" >&2
    return 1
  fi
  set_lifecycle starting
  if ! "$KST_SHELL" "$DAEMON_SCRIPT" start 9>&9; then
    set_lifecycle failed
    log ERROR 'Daemon startup failed'
    echo 'Tailscale daemon startup failed' >&2
    return 1
  fi
  "$KST_SHELL" "$TUNNEL_SCRIPT" start 9>&9 || log WARN 'Data-plane helper startup failed'
  "$KST_SHELL" "$WEB_SCRIPT" start 9>&9 || log WARN 'Official web panel startup failed'
  "$KST_SHELL" "$TAILDROP_SCRIPT" start 9>&9 || log WARN 'Taildrop receiver startup unavailable; inspect logs and unlock shared storage or save another folder'
  if ! supervisor_health; then
    (exec 9>&- 8>&-; unset KST_LOCK_HELD; trap '' HUP; exec "$KST_SHELL" "$SUPERVISOR_SCRIPT") </dev/null >/dev/null 2>&1 &
    local pid=$!
    if ! write_pid "$SUPERVISOR_PID" "$pid" "$SUPERVISOR_SCRIPT"; then
      set_lifecycle failed
      echo 'Supervisor startup failed' >&2
      return 1
    fi
  fi
  set_lifecycle running
  echo 'Tailscale runtime started'
}

runtime_enable() { rm -f "$MODDIR/disable"; runtime_start; }
runtime_disable() { : > "$MODDIR/disable"; runtime_stop; }
runtime_toggle() { if module_disabled; then runtime_enable; else runtime_disable; fi; }
runtime_restart() { runtime_stop >/dev/null && runtime_start; }
web_restart() { "$KST_SHELL" "$WEB_SCRIPT" stop 9>&9 && "$KST_SHELL" "$WEB_SCRIPT" start 9>&9; }

taildrop_save_directory() (
  local directory error source temporary line written=0 wanted
  if migration_required || [ -f "$TS_DIR/migration-awaiting-enable" ]; then
    echo 'Complete identity migration and enable Tailscale before choosing a Taildrop folder' >&2
    exit 1
  fi
  directory=$(read_taildrop_directory) || { echo 'Exactly one folder line without control characters is required' >&2; exit 2; }
  valid_taildrop_directory "$directory" || { echo 'Choose a folder below an Android shared-storage root; traversal and mount-root destinations are not allowed' >&2; exit 2; }
  if ! error=$(taildrop_enter_directory "$directory" create || { printf '%s\n' "$TAILDROP_ERROR"; exit 1; }); then
    printf '%s\n' "$error" >&2
    exit 1
  fi
  source="$CONFIG_DIR/module.conf"
  [ ! -L "$source" ] || { echo 'Refusing symbolic-link configuration file' >&2; exit 1; }
  [ -f "$source" ] || source="$BUNDLE_DIR/tailscale/config/module.conf"
  [ -f "$source" ] || { echo 'Configuration file is missing' >&2; exit 1; }
  temporary=$(mktemp "$CONFIG_DIR/.module.conf.XXXXXX") || exit 1
  trap 'rm -f "$temporary"' EXIT HUP INT TERM
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      TAILDROP_DIR=*)
        if [ "$written" = 0 ]; then printf 'TAILDROP_DIR=%s\n' "$directory"; written=1; fi ;;
      *) printf '%s\n' "$line" ;;
    esac
  done < "$source" > "$temporary" || exit 1
  if [ "$written" = 0 ]; then printf 'TAILDROP_DIR=%s\n' "$directory" >> "$temporary" || exit 1; fi
  chmod 0600 "$temporary" && mv -f "$temporary" "$CONFIG_DIR/module.conf" || exit 1
  trap - EXIT HUP INT TERM
  # Saving a folder never touches the daemon, identity or network preferences.
  if ! "$KST_SHELL" "$TAILDROP_SCRIPT" stop 9>&9; then
    log WARN 'Taildrop folder saved, but owned receiver stop failed; inspect logs before recovery'
    echo 'Folder saved; receiver could not stop safely. Inspect Logs.'
    exit 0
  fi
  IFS= read -r wanted < "$RUN_DIR/wanted" 2>/dev/null || wanted=
  if [ "$wanted" = 1 ] && ! module_disabled && daemon_running; then
    if ! "$KST_SHELL" "$TAILDROP_SCRIPT" start 9>&9; then
      log WARN 'Taildrop folder saved, but receiver startup is unavailable; recovery will retry'
      echo 'Folder saved; receiver is unavailable. Inspect Logs and shared-storage access.'
      exit 0
    fi
  fi
  printf 'Taildrop folder saved: %s\n' "$directory"
)

version_of() { sed -n 's/^version=//p' "$1/module.prop" 2>/dev/null | head -n 1; }
version_json() {
  local version
  version=$(version_of "$1")
  if [ -n "$version" ]; then printf '"%s"' "$(json_escape "$version")"; else printf 'null'; fi
}

status_json() {
  local enabled=true supervisor=stopped daemon=stopped web=stopped lifecycle=stopped config_ok=1 receiver=stopped
  local tailscale_status=null tailscale_prefs=null module_version engine_version backend warning health saved
  DIAGNOSTICS=
  DATA_PLANE=stopped
  load_config || { config_ok=0; diagnostic config-invalid error "$CONFIG_ERROR"; }
  module_disabled && enabled=false
  supervisor_health && supervisor=running
  daemon_running && daemon=running
  if web_running; then
    if [ "$config_ok" = 1 ] && tcp_ready "$WEB_LISTEN"; then web=running; else web=unknown; fi
  fi
  if taildrop_running; then
    if taildrop_health; then receiver=running; else receiver=unknown; fi
  elif [ -f "$TAILDROP_PID" ] && ! record_process_gone "$TAILDROP_PID"; then receiver=unknown
  fi
  if [ -n "$TAILDROP_CONFIG_ERROR" ]; then diagnostic taildrop-config-invalid warning "$TAILDROP_CONFIG_ERROR"; fi
  if [ "$daemon" = running ]; then
    if ! tailscale_status=$(cli_json status status --json); then
      tailscale_status=null
      diagnostic api-unavailable error 'Tailscale status timed out, failed, or contained malformed JSON'
    fi
    if ! tailscale_prefs=$(cli_json prefs debug prefs); then
      tailscale_prefs=null
      diagnostic prefs-unavailable warning 'Tailscale preferences timed out, failed, or contained malformed JSON'
    fi
    if [ "$tailscale_status" != null ] && [ "$config_ok" = 1 ]; then
      data_plane_health "$tailscale_status" || true
      android_login_diagnostics "$tailscale_status"
      health=$(printf '%s' "$tailscale_status" | json_read health)
      [ -z "$health" ] || diagnostic upstream-health warning 'Tailscale reports health warnings; see tailscale.Health'
    else DATA_PLANE=unknown
    fi
    if [ "$tailscale_prefs" != null ]; then
      for warning in $(printf '%s' "$tailscale_prefs" | json_read warnings); do
        case "$warning" in
          dns) diagnostic dns-accepted warning 'Effective preferences accept Tailscale DNS settings' ;;
          routes) diagnostic routes-accepted warning 'Effective preferences accept advertised subnet routes' ;;
          exit) diagnostic exit-node-configured warning 'Effective preferences select an exit node' ;;
          advertised) diagnostic routes-advertised warning 'Effective preferences advertise routes' ;;
        esac
      done
    fi
  fi
  saved=$(sed -n '1p' "$RUN_DIR/lifecycle" 2>/dev/null)
  if [ "$enabled" = false ]; then lifecycle=disabled
  elif migration_required; then lifecycle=migration-required; diagnostic migration-required warning 'Legacy identity requires explicit migration'
  elif [ "$config_ok" = 0 ] || [ ! -x "$TAILSCALED_BIN" ]; then lifecycle=failed
  elif [ "$daemon" = running ]; then
    lifecycle=running
    backend=$(printf '%s' "$tailscale_status" | json_read backend 2>/dev/null)
    if [ "$supervisor" != running ] || [ "$web" != running ] || [ "$DATA_PLANE" != running ] || [ -n "$health" ]; then lifecycle=degraded; fi
    [ "$web" = running ] || diagnostic web-unavailable warning 'Official loopback web panel is not ready'
    [ "$supervisor" = running ] || diagnostic supervisor-unavailable warning 'Runtime supervision is not running'
    if [ "$receiver" != running ]; then
      diagnostic taildrop-unavailable warning 'Taildrop receiver is unavailable; unlock or mount shared storage, check the saved folder, and inspect Logs; queued files remain in the private inbox'
    fi
  elif [ "$saved" = starting ]; then lifecycle=starting
  elif [ "$saved" = failed ] || [ "$(sed -n '1p' "$RUN_DIR/wanted" 2>/dev/null)" = 1 ]; then
    lifecycle=failed; diagnostic daemon-stopped error 'Runtime is requested but the owned daemon is stopped'
  fi
  if [ -f "$RUN_DIR/activation-failure" ]; then diagnostic activation-failed error 'Runtime activation failed; inspect retained runtime versions'; fi
  if [ -d "$TS_DIR/engine-transaction" ]; then diagnostic engine-update-interrupted warning 'Engine update recovery is pending; start the service to restore the previous engine and saved identity'; fi
  if [ -f "$TS_DIR/migration-awaiting-enable" ]; then diagnostic migration-awaiting-enable info 'Migrated identity is preserved; explicit enable or start is required'; fi
  if [ -f "$RUN_DIR/recovery-failure" ]; then diagnostic recovery-backoff warning 'Owned process recovery is retrying with bounded backoff'; fi
  [ -x "$TAILSCALED_BIN" ] || diagnostic bundle-missing error 'Runtime daemon executable is missing'
  module_version=$(version_of "$BUNDLE_DIR")
  engine_version=$(bounded "$KST_CLI_TIMEOUT" "$TAILSCALE_BIN" version 2>/dev/null | head -n 1 | redact)
  printf '{"schemaVersion":2,"enabled":%s,"mode":"%s","lifecycle":"%s",' "$enabled" "$MODE" "$lifecycle"
  printf '"webListen":"%s",' "$(json_escape "$WEB_LISTEN")"
  printf '"moduleVersion":"%s","tailscaleVersion":"%s",' "$(json_escape "$module_version")" "$(json_escape "$engine_version")"
  printf '"components":{"supervisor":"%s","daemon":"%s","dataPlane":"%s","web":"%s"},' "$supervisor" "$daemon" "$DATA_PLANE" "$web"
  printf '"taildrop":{"directory":"%s","receiver":"%s"},' "$(json_escape "$TAILDROP_DIR")" "$receiver"
  printf '"runtime":{"activeVersion":'; version_json "$BUNDLE_DIR"
  printf ',"stagedVersion":'; version_json "$KST_STAGED_DIR"
  printf ',"previousVersion":'; version_json "$TS_DIR/previous"
  printf '},"tailscale":%s,"prefs":%s,"diagnostics":[%s]}\n' "$tailscale_status" "$tailscale_prefs" "$DIAGNOSTICS"
}

runtime_logs() {
  local file
  for file in "$LOG_DIR/supervisor.log" "$LOG_DIR/tailscaled.log" "$LOG_DIR/web.log" "$LOG_DIR/tunnel.log" "$LOG_DIR/taildrop.log"; do
    [ -f "$file" ] || continue
    printf '=== %s ===\n' "${file##*/}"
    tail -c 32768 "$file" | tail -n 100 | redact
  done
}

# This explicit action is the only response allowed to return a sign-in URL.
login_server() {
  local server extra previous auth='""' attempt=0
  IFS= read -r server || { echo 'A single server URL line is required' >&2; return 2; }
  if IFS= read -r extra || [ -n "$extra" ]; then echo 'Only one server URL is allowed' >&2; return 2; fi
  server=${server:-https://controlplane.tailscale.com}
  server=$(printf '%s\n' "$server" | json_read validate-server) || { echo 'Invalid HTTP/HTTPS server base URL' >&2; return 2; }
  if module_disabled || migration_required || [ -f "$TS_DIR/migration-awaiting-enable" ]; then
    echo 'Enable the module and complete any migration before signing in' >&2; return 1
  fi
  daemon_running || { echo 'The owned Tailscale daemon must be running' >&2; return 1; }
  previous=$(cli_json auth-url status --json) || return 1
  # Masked preference edits retain DNS, routes, hostname and other user choices.
  # Restart the control client, not the daemon or Android device.
  bounded "$KST_CLI_TIMEOUT" "$TAILSCALE_BIN" --socket="$SOCKET_FILE" debug localapi PATCH /localapi/v0/prefs \
    "{\"ControlURL\":\"$server\",\"ControlURLSet\":true,\"WantRunning\":true,\"WantRunningSet\":true}" >/dev/null 2>&1 || { echo 'Could not save control server preference' >&2; return 1; }
  bounded "$KST_CLI_TIMEOUT" "$TAILSCALE_BIN" --socket="$SOCKET_FILE" debug localapi POST /localapi/v0/start '{}' >/dev/null 2>&1 || { echo 'Server saved, but control client startup failed' >&2; return 1; }
  bounded "$KST_CLI_TIMEOUT" "$TAILSCALE_BIN" --socket="$SOCKET_FILE" debug localapi POST /localapi/v0/login-interactive >/dev/null 2>&1 || { echo 'Server saved, but interactive sign-in failed' >&2; return 1; }
  while [ "$attempt" -lt 5 ]; do
    auth=$(cli_json auth-url status --json) || return 1
    [ "$auth" = '""' ] || [ "$auth" = "$previous" ] || break
    auth='""'
    attempt=$((attempt + 1))
    [ "$attempt" -ge 5 ] || sleep 1
  done
  printf '{"controlURL":"%s","authURL":%s}\n' "$server" "$auth"
}

case "$1" in
  enable) with_control_lock runtime_enable ;;
  disable) with_control_lock runtime_disable ;;
  toggle) with_control_lock runtime_toggle ;;
  start) with_control_lock runtime_start ;;
  stop) with_control_lock runtime_stop ;;
  restart) with_control_lock runtime_restart ;;
  status) status_json ;;
  status-json) status_json ;;
  logs) runtime_logs ;;
  diagnostics) status_json; runtime_logs ;;
  web-restart) with_control_lock web_restart ;;
  login-server) with_control_lock login_server ;;
  taildrop-save-dir) with_control_lock taildrop_save_directory ;;
  *) echo 'usage: tailscale-service {enable|disable|toggle|start|stop|restart|status|status-json|logs|web-restart|diagnostics|login-server|taildrop-save-dir}' >&2; exit 2 ;;
esac
